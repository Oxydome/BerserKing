[gd_scene load_steps=3 format=3 ]

[ext_resource type="Script" path="res://assets/scripts/scenes/character_select.gd" id="1_charsel"]
[ext_resource type="PackedScene"  path="res://assets/objects/menus/character_info.tscn" id="2_card"]

[node name="CharacterSelect" type="Control" node_paths=PackedStringArray("characters_container", "back_button")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_charsel")
character_card_scene = ExtResource("2_card")
characters_container = NodePath("Panel/HBoxContainer/VBoxContainer/Characters")
back_button = NodePath("Panel/HBoxContainer/VBoxContainer/Back")

[node name="Panel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="HBoxContainer" type="HBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1

[node name="VBoxContainer" type="VBoxContainer" parent="Panel/HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/separation = 24
alignment = 1

[node name="Title" type="Label" parent="Panel/HBoxContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 46
text = "Character Select"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Subtitle" type="Label" parent="Panel/HBoxContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.8, 0.9, 1)
theme_override_font_sizes/font_size = 18
text = "Choose your warrior before heading into battle"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Characters" type="HBoxContainer" parent="Panel/HBoxContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 16
alignment = 1

[node name="Back" type="Button" parent="Panel/HBoxContainer/VBoxContainer"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
size_flags_horizontal = 4
text = "BACK"

[connection signal="pressed" from="Panel/HBoxContainer/VBoxContainer/Back" to="." method="_on_back_pressed"]
